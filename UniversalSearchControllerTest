@IsTest
private class UniversalSearchControllerTest {

    @TestSetup
    static void setup() {
        Account acc = new Account(Name = 'TestAcme Corp', Industry = 'Technology');
        insert acc;

        Contact con = new Contact(FirstName = 'John', LastName = 'TestAcme', 
                                   Email = 'john@testacme.com', AccountId = acc.Id);
        insert con;

        Opportunity opp = new Opportunity(Name = 'TestAcme Deal', StageName = 'Prospecting',
                                           CloseDate = Date.today().addDays(30), 
                                           Amount = 50000, AccountId = acc.Id);
        insert opp;
    }

    @IsTest
    static void testSearchWithResults() {
        Test.setFixedSearchResults(getFixedIds());

        Test.startTest();
        UniversalSearchController.SearchWrapper result = 
            UniversalSearchController.searchRecords('TestAcme');
        Test.stopTest();

        System.assertNotEquals(null, result, 'Result should not be null');
    }

    @IsTest
    static void testEmptySearchTerm() {
        Test.startTest();
        UniversalSearchController.SearchWrapper result = 
            UniversalSearchController.searchRecords('');
        Test.stopTest();

        System.assertEquals(0, result.accounts.size(), 'Should return empty list for blank search');
    }

    @IsTest
    static void testNullSearchTerm() {
        Test.startTest();
        UniversalSearchController.SearchWrapper result = 
            UniversalSearchController.searchRecords(null);
        Test.stopTest();

        System.assertEquals(0, result.accounts.size(), 'Should handle null gracefully');
    }

    private static List<List<SObject>> getFixedIds() {
        Account acc = [SELECT Id FROM Account LIMIT 1];
        Contact con = [SELECT Id FROM Contact LIMIT 1];
        Opportunity opp = [SELECT Id FROM Opportunity LIMIT 1];
        return new List<List<SObject>>{
            new List<Account>{acc},
            new List<Contact>{con},
            new List<Opportunity>{opp}
        };
    }
}
