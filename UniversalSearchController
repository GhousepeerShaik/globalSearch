public with sharing class UniversalSearchController {

    @AuraEnabled
    public static SearchWrapper searchRecords(String searchTerm) {
        SearchWrapper result = new SearchWrapper();

        if (String.isBlank(searchTerm)) {
            return result;
        }

        String searchKey = searchTerm.trim() + '*';

        List<List<SObject>> searchResults = [
            FIND :searchKey
            IN NAME FIELDS
            RETURNING
                Account(Id, Name, Industry),
                Contact(Id, Name, Email, Account.Name),
                Opportunity(Id, Name, StageName, Amount)
        ];

        result.accounts = (List<Account>) searchResults[0];
        result.contacts = (List<Contact>) searchResults[1];
        result.opportunities = (List<Opportunity>) searchResults[2];

        return result;
    }

    public class SearchWrapper {
        @AuraEnabled public List<Account> accounts = new List<Account>();
        @AuraEnabled public List<Contact> contacts = new List<Contact>();
        @AuraEnabled public List<Opportunity> opportunities = new List<Opportunity>();
    }
}
